{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "lib": ["ES2022", "ESNext"],
    "declaration": true,
    "strict": true,
    "types": ["node"],
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strictPropertyInitialization": true,
    "moduleResolution": "nodenext",
    "stripInternal": true,
    "skipLibCheck": true
  }
}
