{
  "name": "awesome-publish",
  "version": "0.0.1",
  "description": "Effortless npm package publishing with pipeline architecture",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "bin": {
    "awesome-publish": "./lib/cli/index.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm eslint ./src/**",
    "test": "vitest run",
    "prebuild": "pnpm rimraf lib",
    "build": "tsc -p .",
    "dev": "node --loader ts-node/esm ./src/cli/index.ts"
  },
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@awdware/prettier-config": "^1.0.0",
    "@eslint/js": "^10.0.0",
    "@ngneers/eslint-config": "^3.1.1",
    "@types/node": "^25.8.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "legally": "^3.5.10",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "4.1.6"
  },
  "prettier": "@awdware/prettier-config",
  "keywords": [
    "typescript"
  ],
  "author": {
    "name": "Janik Schumacher (LoaderB0T)",
    "url": "https://awdware.de"
  },
  "homepage": "https://github.com/LoaderB0T/awesome-publish",
  "bugs": {
    "url": "https://github.com/LoaderB0T/awesome-publish/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LoaderB0T/awesome-publish.git"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "awesome-logging": "^2.1.1",
    "citty": "^0.2.2",
    "glob": "^13.0.6",
    "jiti": "^2.7.0"
  }
}
