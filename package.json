{
  "name": "awesome-publish",
  "version": "0.0.10",
  "description": "Effortless npm package publishing with pipeline architecture",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "awesome-publish": "./lib/cli/index.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "oxlint --type-aware",
    "format": "oxfmt \"**/*.{ts,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,json,md}\"",
    "check:changed": "tsx tools/lint-changed.ts",
    "fix:changed": "tsx tools/lint-changed.ts --format-fix --lint-fix",
    "test": "vitest run",
    "prebuild": "pnpm rimraf lib",
    "build": "tsc -p .",
    "prepublishOnly": "pnpm build",
    "dev": "tsx ./src/cli/index.ts",
    "prepare": "husky"
  },
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/semver": "^7.7.1",
    "husky": "^9.1.7",
    "legally": "^3.5.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.6"
  },
  "keywords": [
    "typescript"
  ],
  "author": {
    "name": "Janik Schumacher (LoaderB0T)",
    "url": "https://awdware.de"
  },
  "homepage": "https://github.com/LoaderB0T/awesome-publish",
  "bugs": {
    "url": "https://github.com/LoaderB0T/awesome-publish/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LoaderB0T/awesome-publish.git"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "awesome-logging": "^3.0.0-pre2",
    "citty": "^0.2.2",
    "glob": "^13.0.6",
    "jiti": "^2.7.0",
    "semver": "^7.8.5"
  }
}
