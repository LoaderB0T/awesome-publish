{
  "name": "typescript-starter",
  "version": "0.0.0",
  "description": "A template for typescript projects",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "files": [
    "lib"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm eslint ./src/**",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "prebuild": "pnpm rimraf lib",
    "build": "tsc -p .",
    "test-script": "node --loader ts-node/esm ./src/test.ts"
  },
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@awdware/prettier-config": "^1.0.0",
    "@eslint/js": "^10.0.0",
    "@jest/globals": "^30.4.1",
    "@ngneers/eslint-config": "^3.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "legally": "^3.5.10",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "prettier": "@awdware/prettier-config",
  "keywords": [
    "typescript"
  ],
  "author": {
    "name": "Janik Schumacher (LoaderB0T)",
    "url": "https://awdware.de"
  },
  "homepage": "https://github.com/LoaderB0T/typescript-starter",
  "bugs": {
    "url": "https://github.com/LoaderB0T/typescript-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LoaderB0T/typescript-starter.git"
  }
}
